# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: The Movie Database API Key v3 or v4 Read Access Token (SERVER-SIDE ONLY)
# Used for live title discovery, trending, search, genres, posters, and cast.
TMDB_API_KEY=""

# Supabase integration (optional client-side persistence)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# NOTE: VidRift streaming requires NO API key or account credentials.
# Embeds are generated directly using TMDB/AniList IDs via https://embed.vidrift.net
